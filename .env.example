# ========================
# ASR 提供商选择
# ========================
# 可选: zhipu (默认) | volcengine | ali
ASR_PROVIDER=zhipu

# ========================
# 智谱 GLM-ASR-2512（默认推荐）
# 文档: https://docs.bigmodel.cn/cn/guide/models/sound-and-video/glm-asr-2512
# ========================
ZHIPU_API_KEY=your-zhipu-api-key

# ========================
# 字节 Seed-ASR 2.0（性价比最高）
# 文档: https://www.volcengine.com/docs/6561/1354868
# ========================
VOLCENGINE_API_KEY=your-volcengine-api-key
VOLCENGINE_POLL_INTERVAL=0.1

# 字节 Seed-ASR 需要先把音频上传到对象存储（TOS）
TOS_ACCESS_KEY=your-tos-ak
TOS_SECRET_KEY=your-tos-sk
TOS_ENDPOINT=tos-cn-shanghai.volces.com
TOS_BUCKET=your-bucket-name

# ========================
# 阿里 Qwen-Omni-Turbo（多模态扩展）
# 文档: https://help.aliyun.com/zh/model-studio/user-guide/qwen-omni
# ========================
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
ALI_ASR_MODEL=qwen-omni-turbo

# ========================
# LLM 后处理（OpenAI 兼容格式）
# ========================
LLM_API_KEY=sk-yyyy
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30.0

# ========================
# 热键配置
# ========================
HOTKEY_RECORD=f9
HOTKEY_FEEDBACK=f10

# ========================
# 词表
# ========================
GLOSSARY_PATH=glossary.json
